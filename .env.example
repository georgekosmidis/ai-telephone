# One Azure AI Foundry resource + one key serves everything.
# Use the resource host (no /anthropic or /openai/v1 suffix, no trailing slash).
AZURE_AI_ENDPOINT=https://geko-test.services.ai.azure.com
AZURE_AI_KEY=

# Story: Claude via the Anthropic Messages API (/anthropic route).
AZURE_AI_STORY_DEPLOYMENT=claude-opus-5-5

# Images: gpt-image via the OpenAI-compatible route (/openai/v1).
AZURE_AI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst

# AI telephone: number of improve-this rounds.
GENERATIONS=20


